# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
build/
dist/
.venv/
venv/
.env

# Vendored upstream repos (cloned, not committed) -- but keep the version record
# and each repo's provenance note. (The two-level negation is required: git
# won't descend into an ignored directory unless the directory itself is
# re-included.)
third_party/*
!third_party/VERSIONS.md
!third_party/*/
third_party/*/*
!third_party/*/PROVENANCE.md

# Run artifacts -- but the frozen interpretation-class artifact is tracked
# (a research artifact, decisions/005, not a run product)
data/*
!data/interpretation_classes.json
!data/interpretation_classes_pilot.json
!data/interpretation_classes_new/
!data/judge_validation_pairs.json
!data/fork_type_annotations.json
!data/fork_type_annotations.review.json
# decisions/029: registry pins (sha256 per resolution, id order, defective
# ids) and the owner-reviewed rival-resolution fixture -- both are frozen
# protocol inputs that the contract suite asserts against
!data/cis_registry_pins.json
!data/cis_rival_resolutions_pilot.json
!data/cis_lean_statements_pilot.json
# Judge-labelling arm (decisions/025 + Amendment A): the frozen validation
# set and the frozen judge-label artifacts are research artifacts, tracked.
!data/label_judge_validation.json
!data/judge_labels_*.jsonl
# R1 pilot audit trail (decisions/023): the per-run steps/reads/timings behind
# a go/no-go gate, 48K total. The 2.2GB activations are NOT kept. Two-level
# negation as above: re-include the dir, re-ignore its contents, then pick.
!data/a0_pilot_32b/
data/a0_pilot_32b/*
!data/a0_pilot_32b/events.s*.jsonl
!data/a0_pilot_32b/collection_manifest.s*.json
logs/
models/
*.pt
*.bin
*.safetensors
*.npz

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Reference papers (copyrighted third-party PDFs; local-only, not for a public repo)
multi trajectory disagreement about same idea/

# Secrets -- never commit
*.pem
*.key
.env.*


# session data tarballs (derived artifacts, keep out of history)
a0_sample_3task.tar.gz
a0_v1.5_full_*.tar.gz
wta-a0-*.tar.gz

# Large collection artifacts that live beside the repo, never in it.
# (2026-08-22: a `git add -A` swept the 45GB R2 tarball into a commit; the
# commit was undone before pushing. These patterns make that unrepeatable.)
*.tar.zst
*.tar.zst.sha256
*.tar.gz
recovered_runs/
results_r2_frozen/
r2_missing_runs.txt
